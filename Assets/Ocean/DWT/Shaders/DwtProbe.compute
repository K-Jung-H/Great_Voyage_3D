#pragma kernel Probe
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "DwtSynthesis.hlsl"
RWStructuredBuffer<float> _Results;
float _ProbeSpacing;
[numthreads(8,8,1)]
void Probe(uint3 id : SV_DispatchThreadID)
{
    float2 p=(float2(id.xy)-15.5)*1.37+float2(.173,.391);
    float variance;
    _Results[id.y*32+id.x]=DwtHeight(p+_OceanOrigin.xz,
        float2(_ProbeSpacing,0),float2(0,_ProbeSpacing),variance);
}
